#!/usr/bin/env bash
# agent-skills setup — register all skills with Claude Code and Codex
set -e

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILLS_DIRS=(
  "$HOME/.claude/skills"
  "$HOME/.agents/skills"
)

for skills_dir in "${SKILLS_DIRS[@]}"; do
  mkdir -p "$skills_dir"
done

installed=0
for skill_dir in "$REPO_DIR"/*/; do
  [ -f "$skill_dir/SKILL.md" ] || continue
  skill_name="$(basename "$skill_dir")"
  for skills_dir in "${SKILLS_DIRS[@]}"; do
    ln -snf "$skill_dir" "$skills_dir/$skill_name"
  done
  echo "  ✓ /$skill_name"
  installed=$((installed + 1))
done

if [ "$installed" -eq 0 ]; then
  echo "No skills found (no */SKILL.md directories)." >&2
  exit 1
fi

echo ""
echo "Installed $installed skill(s) to:"
for skills_dir in "${SKILLS_DIRS[@]}"; do
  echo "  - $skills_dir"
done
echo "Usage:"
echo "  Claude Code: type /<skill-name>"
echo "  Codex: reference the skill by name in your request"
